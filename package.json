{
  "name": "crm-express",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "netlify:build": "prisma generate && prisma db push && node prisma/seed.mjs && next build",
    "db:push": "prisma db push",
    "db:seed": "SEED_DEMO=true node prisma/seed.mjs",
    "db:seed:prod": "node prisma/seed.mjs",
    "db:reset": "rm -f prisma/dev.db && prisma db push && SEED_DEMO=true node prisma/seed.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "^1.6.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
