# Modelo de variáveis de ambiente. Copie para .env (local) ou cole no painel do
# Netlify (produção). NUNCA commitar o .env de verdade (já está no .gitignore).

# ── Banco de dados ──────────────────────────────────────────────────
# Local (dev): SQLite, arquivo. Produção: string do Postgres (Neon/Supabase).
# Ex. Neon: postgresql://usuario:senha@host.neon.tech/dbname?sslmode=require
DATABASE_URL="file:./dev.db"

# ── URL pública da aplicação ────────────────────────────────────────
# Usada nos links de convite e de redefinição de senha. Em produção, o domínio
# do Netlify (ou o domínio customizado). Sem barra no final.
APP_URL="http://localhost:3000"

# ── SMTP (obrigatório em produção) ──────────────────────────────────
# Sem SMTP em produção, convites e redefinição de senha não são enviados (e o
# link nunca aparece na tela, por segurança). Use o webmail interno da Teknisa.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CRM Express <no-reply@teknisa.com>"

# ── Domínio de email aceito no autocadastro ─────────────────────────
ALLOWED_EMAIL_DOMAIN="teknisa.com"

# ── Chave de criptografia das Server Actions (produção) ─────────────
# Necessária quando há mais de uma instância (o Netlify escala em várias).
# Gere uma chave estável e cole aqui: openssl rand -hex 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ── Dados de demonstração ───────────────────────────────────────────
# true = cria contas de exemplo (senha teknisa123) e clientes fictícios.
# EM PRODUÇÃO NÃO DEFINIR (ou deixar vazio): senão o sistema nasce com contas
# que qualquer um acessa.
SEED_DEMO=""
